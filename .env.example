# 이 파일을 .env로 복사한 뒤 값을 채워서 사용하세요. (.env는 git에 커밋되지 않습니다)
#
# 아래 명령어로 무작위 SECRET_KEY를 생성할 수 있습니다:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 개발 중에는 0(=false)로 두고, ngrok 등 HTTPS 환경에서 테스트할 때만 1(=true)로 설정하세요.
# true로 설정한 상태에서 http://localhost 로 접속하면 세션 쿠키가 전송되지 않습니다.
SESSION_COOKIE_SECURE=false

# 디버그 모드 (절대 배포 환경에서 1로 두지 마세요 - 스택트레이스/코드 실행 노출 위험)
FLASK_DEBUG=0
